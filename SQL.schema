-- 1. Customers Table
create table customers (
  id uuid default gen_random_uuid() primary key,
  name text not null,
  mobile text not null,
  created_at timestamp with time zone default timezone('utc'::text, now()) not null
);

-- 2. Profiles Table (Users & Admins)
create table profiles (
  id uuid default gen_random_uuid() primary key,
  username text unique not null,
  password text not null,
  role text default 'user', -- 'admin' or 'user'
  status text default 'active' -- 'active' or 'deactive'
);

-- Default Admin Account
insert into profiles (username, password, role, status) 
values ('admin', 'admin123', 'admin', 'active');

-- 3. Settings Table
create table settings (
  id int primary key default 1,
  logo_url text,
  primary_color text default '#A11D26',
  body_color text default '#f3f4f6'
);


-- 1. Feedback Questions Table
create table feedback_questions (
  id uuid default gen_random_uuid() primary key,
  question_text text not null,
  is_active boolean default true,
  created_at timestamp with time zone default timezone('utc'::text, now()) not null
);

-- 2. Customer Feedbacks Table
create table customer_feedbacks (
  id uuid default gen_random_uuid() primary key,
  customer_name text not null,
  customer_mobile text not null,
  question_id uuid references feedback_questions(id) on delete cascade,
  answer text not null,
  created_at timestamp with time zone default timezone('utc'::text, now()) not null
);

-- RLS Disable (Agar error se bachna hai)
alter table feedback_questions disable row level security;
alter table customer_feedbacks disable row level security;


alter table feedback_questions add column if not exists options text;

-- Purani feedback table drop karein aur nayi structured table banayein

drop table if exists customer_feedbacks;

create table customer_feedbacks (
  id uuid default gen_random_uuid() primary key,
  customer_name text not null,
  customer_mobile text not null,
  feedback_data jsonb not null, -- Isme sare questions, answers aur comment JSON ki shakal me aik hi line me save honge
  comment text,
  created_at timestamp with time zone default timezone('utc'::text, now()) not null
);

alter table customer_feedbacks disable row level security;


-- Agar feedback_questions table pehle se hai toh yeh columns add kar dein:
alter table feedback_questions add column if not exists is_active boolean default true;
alter table feedback_questions add column if not exists sort_order int default 0;





